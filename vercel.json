{
  "buildCommand": "npx playwright install chromium && next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "functions": {
    "app/api/run-scraper/route.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": [
        {
          "src": "node_modules/@sparticuz/chromium/bin/**",
          "dest": "chromium-assets"
        }
      ]
    }
  },
  "env": {
    "PLAYWRIGHT_BROWSERS_PATH": "0"
  }
} 